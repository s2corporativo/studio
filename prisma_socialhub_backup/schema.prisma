// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  description String?
  niche       String?
  website     String?
  brandColor  String?  @default("#6366f1")
  city        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  socialAccounts SocialAccount[]
  posts          Post[]
  analytics      AnalyticsSnapshot[]
  seoKeywords    SeoKeyword[]
  templates      ContentTemplate[]
  mediaAssets    MediaAsset[]
  contentIdeas   ContentIdea[]
  activityEvents ActivityEvent[]
  settings       CompanySettings?
  hashtagGroups  HashtagGroup[]
  competitors    Competitor[]
  mentions       Mention[]
  integrations   Integration[]
  reports        Report[]
}

model SocialAccount {
  id           String   @id @default(cuid())
  companyId    String
  platform     String   // instagram, facebook, linkedin, twitter, tiktok, youtube
  handle       String
  displayName  String?
  avatarUrl    String?
  profileUrl   String?
  followers    Int      @default(0)
  following    Int      @default(0)
  posts        Int      @default(0)
  connected    Boolean  @default(false)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postTargets PostTarget[]
}

model Post {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  content     String
  mediaUrls   String   @default("[]") // JSON array of URLs
  hashtags    String   @default("[]") // JSON array of strings
  scheduledAt DateTime?
  status      String   @default("draft") // draft, scheduled, publishing, published, failed
  category    String?  // promo, educational, engagement, announcement, story
  tone        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targets PostTarget[]
}

model PostTarget {
  id             String   @id @default(cuid())
  postId         String
  platform       String
  content        String   // platform-specific tailored content
  status         String   @default("pending") // pending, published, failed
  publishedAt    DateTime?
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  saves          Int      @default(0)
  reach          Int      @default(0)
  impressions    Int      @default(0)

  post           Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount  SocialAccount? @relation(fields: [socialAccountId], references: [id])
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  platform    String
  date        DateTime
  followers   Int      @default(0)
  reach       Int      @default(0)
  engagement  Int      @default(0)
  clicks      Int      @default(0)
  impressions Int      @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model SeoKeyword {
  id         String   @id @default(cuid())
  companyId  String
  keyword    String
  volume     Int      @default(0)
  difficulty Int      @default(0)
  rank       Int      @default(0)
  trend      String   @default("up") // up, down, stable
  intent     String   @default("informational") // informational, commercial, transactional, navigational
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ContentTemplate {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  structure String
  tone      String?
  category  String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id          String   @id @default(cuid())
  companyId   String?
  title       String
  description String?
  url         String
  thumbnail   String?
  type        String   @default("image") // image, video
  source      String   @default("ai") // ai, upload, stock
  prompt      String?
  width       Int?
  height      Int?
  tags        String   @default("[]") // JSON array
  attachedTo  Int      @default(0)
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ContentIdea {
  id          String   @id @default(cuid())
  companyId   String?
  title       String
  description String
  category    String   @default("educacional") // promocional, educacional, engajamento, anuncio, storytelling, produto
  platform    String   @default("instagram")
  angle       String?  // hook angle / approach
  hashtags    String   @default("[]")
  bestDay     String?  // suggested day of week
  bestTime    String?  // suggested time
  status      String   @default("idea") // idea, planned, used
  score       Int      @default(50) // relevance score 0-100
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id        String   @id @default(cuid())
  companyId String?
  type      String   // post_created, post_scheduled, post_published, media_generated, idea_generated, company_added, account_connected, seo_optimized
  title     String
  description String?
  icon      String?
  color     String?
  meta      String?  // JSON extra data
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanySettings {
  id               String   @id @default(cuid())
  companyId        String   @unique
  brandVoice       String?  // tom/voz da marca descrito em texto
  targetAudience   String?
  defaultTone      String   @default("profissional")
  defaultPlatforms String   @default("[]") // JSON array
  defaultHashtags  String   @default("[]") // JSON array
  hashtagCount     Int      @default(8)
  aiCreativity     Int      @default(70) // 0-100
  autoEmoji        Boolean  @default(true)
  autoHashtags     Boolean  @default(true)
  watermark        Boolean  @default(false)
  postingFrequency String   @default("daily") // daily, weekly, biweekly
  bestPostingTime  String?  // HH:MM
  timezone         String   @default("America/Sao_Paulo")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model HashtagGroup {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  niche       String?
  platform    String?
  tags        String   @default("[]") // JSON array of hashtag strings (without #)
  description String?
  color       String?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Competitor {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  handle      String?
  website     String?
  niche       String?
  platform    String?
  followers  Int      @default(0)
  engagementRate Float @default(0)
  postingFrequency String?
  strengths   String?  // JSON array
  weaknesses  String?  // JSON array
  contentThemes String? // JSON array
  avgLikes    Int      @default(0)
  avgComments Int      @default(0)
  sentiment   String   @default("neutral") // positive, neutral, negative
  threatLevel String   @default("medium") // low, medium, high
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Mention {
  id          String   @id @default(cuid())
  companyId   String
  platform    String   // instagram, facebook, linkedin, twitter, tiktok, youtube, web
  author      String
  authorHandle String?
  authorAvatar String?
  content     String
  url         String?
  sentiment   String   @default("neutral") // positive, neutral, negative
  sentimentScore Float @default(0) // -1 to 1
  reach       Int      @default(0)
  engagement  Int      @default(0)
  language    String   @default("pt-BR")
  isReply     Boolean  @default(false)
  isVerified  Boolean  @default(false)
  tags        String   @default("[]") // JSON array of topics/keywords
  replied     Boolean  @default(false)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Integration {
  id            String   @id @default(cuid())
  companyId     String
  platform      String   // instagram, facebook, linkedin, twitter, tiktok, youtube, google_analytics, google_my_business
  status        String   @default("disconnected") // disconnected, pending, connected, error
  accountId     String?
  accountName   String?
  scopes        String?  // JSON array of granted scopes
  tokenExpiry   DateTime?
  lastSync      DateTime?
  syncFrequency String   @default("hourly") // realtime, hourly, daily
  autoPublish   Boolean  @default(true)
  apiKey        String?  // for manual API key integrations
  apiSecret     String?  // encrypted
  webhookUrl    String?
  errorMessage  String?
  features      String   @default("[]") // JSON: posting, analytics, mentions, stories, reels
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform])
}

model Report {
  id          String   @id @default(cuid())
  companyId   String
  type        String   // weekly, monthly, campaign, competitor
  title       String
  period      String   // "2024-01" or "2024-W03"
  summary     String?
  data        String?  // JSON with full report data
  insights    String?  // JSON with AI-generated insights
  format      String   @default("pdf") // pdf, csv, json
  status      String   @default("generating") // generating, ready, failed
  url         String?  // download URL
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
