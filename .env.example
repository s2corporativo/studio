# Copie para .env e preencha antes de subir com docker compose.
# Nunca commite o .env real (já está no .gitignore).

# --- Universais (necessárias em qualquer hospedagem) --------------------
NODE_ENV=production
PORT=3000
# String de conexão completa; se usar o mysql do docker-compose.yml, ela é
# montada automaticamente a partir das variáveis MYSQL_* abaixo.
DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco
# Segredo usado para assinar a sessão (cookie) e cifrar o token do Instagram.
# Gere um valor aleatório forte, ex.: openssl rand -base64 48
JWT_SECRET=

# --- Banco (usadas pelo serviço mysql do docker-compose.yml) ------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=depaula_social_studio
MYSQL_USER=social_studio
MYSQL_PASSWORD=

# --- Login (fase 1: continua apontando para o Manus) ---------------------
# Dependência remanescente do Manus, documentada no plano de hospedagem
# própria — trocar por outro provedor de login é uma fase futura.
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# --- IA de texto ----------------------------------------------------------
# Compatível com qualquer provedor que fale a API OpenAI (/v1/chat/completions
# e /v1/models). Ver AI_PROVIDER_OPTIONS.md para opções gratuitas e pagas.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
LLM_MODEL=gpt-5-mini

# --- Instagram (Meta Graph API) -------------------------------------------
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
