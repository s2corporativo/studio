# ============================================
# S2 STUDIO — Environment Variables
# ============================================

# APP
NODE_ENV=development
VITE_APP_ID=s2-studio

# DATABASE
# MySQL/TiDB. Todos os schemas Drizzle deste projeto usam o dialeto mysql
# (mysqlTable) — não use uma URL sqlite/file: aqui.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/s2_studio

# AUTH
JWT_SECRET=your-jwt-secret-here
OAUTH_SERVER_URL=http://localhost:3000
OWNER_OPEN_ID=s2-owner

# AI (z-ai-web-dev-sdk — já incluído)
# LLM_MODEL=gpt-5-mini

# STORAGE (optional — defaults to local)
# STORAGE_PROVIDER=local|s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# INSTAGRAM (Meta for Developers)
# META_INSTAGRAM_APP_ID=
# META_INSTAGRAM_APP_SECRET=

# FACEBOOK
# META_FACEBOOK_APP_ID=
# META_FACEBOOK_APP_SECRET=

# LINKEDIN
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# TIKTOK
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=

# GOOGLE
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_BUSINESS_PROFILE_ID=

# OBSERVABILITY (optional)
# LOG_LEVEL=info

# SELF-HOSTING (docker-compose.yml) — só necessário ao rodar via Docker
# com o serviço "db" local (MariaDB). Não usado quando DATABASE_URL aponta
# para um TiDB/MySQL externo já provisionado.
# DB_NAME=s2_studio
# DB_USER=s2_studio
# DB_PASSWORD=
# DB_ROOT_PASSWORD=
